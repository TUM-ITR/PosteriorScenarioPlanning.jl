{
	"name": "julia_container",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"julialang.language-julia",
				"anthropic.claude-code"
			],
			"settings": {
				"editor.formatOnSave": true,
				"julia.executablePath": "/usr/local/bin/julia",
				"julia.environmentPath": "/home/developer/workspace/experiments"
			}
		}
	},
	"remoteUser": "developer",
	"workspaceFolder": "/home/developer/workspace/",
	"mounts": [
		"source=${localWorkspaceFolder},target=/home/developer/workspace/,type=bind"
	],
	"containerEnv": {
		"JULIA_NUM_THREADS": "auto",
		"OPENBLAS_NUM_THREADS": "1",
		"OMP_NUM_THREADS": "1"
	},
	"remoteEnv": {
		"SSH_AUTH_SOCK": "/ssh-agent",
		"JULIA_DEPOT_PATH": "/home/developer/.julia",
		"JULIA_PROJECT": "/home/developer/workspace/experiments"
	},
	"postCreateCommand": "julia --project=experiments -e 'using Pkg; Pkg.develop(path=\".\"); if haskey(ENV, \"HSL_PATH\") && isdir(ENV[\"HSL_PATH\"]); Pkg.develop(path=ENV[\"HSL_PATH\"]); Pkg.add(\"MadNLPHSL\"); end; Pkg.instantiate()'"
}